      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=has_pending_updates</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0aw2woo" sourceRef="Gateway_0znvou8" targetRef="Activity_13t2t5l">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(has_pending_updates)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_13t2t5l" name="Initialize Next Quarter">
