  <bpmn:process id="period-flow" name="period flow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_18qn7ec</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_18qn7ec" sourceRef="StartEvent_1" targetRef="Activity_1on6x9d" />
    <bpmn:serviceTask id="Activity_1on6x9d" name="validate and create period as scheduled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-period" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=year" target="year" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18qn7ec</bpmn:incoming>
      <bpmn:outgoing>Flow_1obu2et</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_0qzsuwz" name="Start Date">
      <bpmn:incoming>Flow_1obu2et</bpmn:incoming>
      <bpmn:outgoing>Flow_0ef7sse</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0jdimgh">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=get value(period, "startDate")</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1obu2et" sourceRef="Activity_1on6x9d" targetRef="Event_0qzsuwz" />
    <bpmn:sequenceFlow id="Flow_0ef7sse" sourceRef="Event_0qzsuwz" targetRef="Activity_1tvaywu" />
    <bpmn:serviceTask id="Activity_1tvaywu" name="Start Period">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-period" />
        <zeebe:ioMapping>
          <zeebe:input source="=year" target="year" />
          <zeebe:output source="=periodUuid" target="periodUuid" />
          <zeebe:output source="=period" target="period" />
          <zeebe:output source="=nextPeriodScheduledDate" target="nextPeriodScheduledDate" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ef7sse</bpmn:incoming>
      <bpmn:outgoing>Flow_0p3qa8s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Activity_0x4xtg6" name="Employee Period assignment">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="assign-employee-period" propagateAllChildVariables="false" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vt4m9k</bpmn:incoming>
      <bpmn:outgoing>Flow_15bt8b2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateCatchEvent id="Event_1wfkt10">
      <bpmn:incoming>Flow_1tkgv5o</bpmn:incoming>
      <bpmn:outgoing>Flow_1yw2rpj</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1c2ukj3">
