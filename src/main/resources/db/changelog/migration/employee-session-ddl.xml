<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">
    <changeSet id="1" author="rvenkata">
        <createTable tableName="employee_session">
            <column name="uuid" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="employee_uuid" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="session_id_hash" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="user_agent_hash" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="status_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="device_type" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="last_accessed_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="expired_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="employee_session" baseColumnNames="employee_uuid"
                                 constraintName="employee_fk" initiallyDeferred="false"
                                 deferrable="false" onDelete="CASCADE" onUpdate="CASCADE"
                                 referencedTableName="employee" referencedColumnNames="uuid"/>

        <createTable tableName="session_status">
            <column name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true" primaryKeyName="session_status_pk"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="session_status">
            <column name="id" value="1"/>
            <column name="name" value="ACTIVE"/>
        </insert>
        <insert tableName="session_status">
            <column name="id" value="2"/>
            <column name="name" value="LOGGED_OUT"/>
        </insert>
        <insert tableName="session_status">
            <column name="id" value="3"/>
            <column name="name" value="REVOKED"/>
        </insert>
        <insert tableName="session_status">
            <column name="id" value="4"/>
            <column name="name" value="EXPIRED"/>
        </insert>

        <addForeignKeyConstraint baseTableName="employee_session" baseColumnNames="status_id"
                                 constraintName="session_statud_id_fk" initiallyDeferred="false"
                                 deferrable="false" onUpdate="CASCADE" onDelete="CASCADE"
                                 referencedTableName="session_status" referencedColumnNames="id"/>

        <createTable tableName="device_type">
            <column name="id" type="INTEGER">
                <constraints nullable="false" primaryKeyName="device_type_id_pk" primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="device_type">
            <column name="id" value="1"/>
            <column name="name" value="WEB"/>
        </insert>
        <insert tableName="device_type">
            <column name="id" value="2"/>
            <column name="name" value="MOBILE"/>
        </insert>
        <insert tableName="device_type">
            <column name="id" value="3"/>
            <column name="name" value="TABLET"/>
        </insert>
        <insert tableName="device_type">
            <column name="id" value="4"/>
            <column name="name" value="UNKNOWN"/>
        </insert>

        <addForeignKeyConstraint baseTableName="employee_session" baseColumnNames="device_type"
                                 constraintName="employee_session_device_type_fk" deferrable="false"
                                 initiallyDeferred="false" onDelete="CASCADE" onUpdate="CASCADE"
                                 referencedTableName="device_type" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>