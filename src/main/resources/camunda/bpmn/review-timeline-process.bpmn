        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=waitingDate</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1o609y0" sourceRef="Activity_04c7jdp" targetRef="Event_05s0cvl" />
    <bpmn:serviceTask id="Activity_0v5c5bx" name="update quarter status">
