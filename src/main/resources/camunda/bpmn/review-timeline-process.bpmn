      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=rows != 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0gdlq6a" sourceRef="Event_0ypt4yo" targetRef="Activity_0v5c5bx" />
