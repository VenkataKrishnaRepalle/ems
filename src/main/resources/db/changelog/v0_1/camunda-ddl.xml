<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">
    <changeSet id="1" author="Venkata Krishna Repalle">
        <createTable tableName="camunda_process_execution">
            <column name="process_key" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="process_key_pk"/>
            </column>
            <column name="employee_uuid" type="${uuid_type}"/>
            <column name="process_definition_id" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="process_name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="status_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="failed_step" type="VARCHAR"/>
            <column name="error_code" type="VARCHAR"/>
            <column name="error_message" type="VARCHAR"/>
            <column name="started_by" type="${uuid_type}"/>
            <column name="started_time" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="completed_time" type="TIMESTAMPTZ"/>
        </createTable>

        <createTable tableName="process_execution_status">
            <column name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true" primaryKeyName="process_execution_status_pk"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR"/>
        </createTable>

        <insert tableName="process_execution_status">
            <column name="id" value="1"/>
            <column name="name" value="IN_PROGRESS"/>
            <column name="description" value="Status in progress"/>
        </insert>

        <insert tableName="process_execution_status">
            <column name="id" value="2"/>
            <column name="name" value="COMPLETED"/>
            <column name="description" value="Status Completed"/>
        </insert>
        <insert tableName="process_execution_status">
            <column name="id" value="3"/>
            <column name="name" value="FAILED"/>
            <column name="description" value="Status FAILED"/>
        </insert>
        <insert tableName="process_execution_status">
            <column name="id" value="4"/>
            <column name="name" value="COMPENSATED"/>
            <column name="description" value="Status COMPENSATED"/>
        </insert>
        <insert tableName="process_execution_status">
            <column name="id" value="5"/>
            <column name="name" value="CANCELLED"/>
            <column name="description" value="Status CANCELLED"/>
        </insert>

        <addForeignKeyConstraint baseTableName="camunda_process_execution" baseColumnNames="status_id"
                                 constraintName="status_fk" deferrable="false"
                                 initiallyDeferred="false" onUpdate="CASCADE" onDelete="CASCADE"
                                 referencedTableName="process_execution_status" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>