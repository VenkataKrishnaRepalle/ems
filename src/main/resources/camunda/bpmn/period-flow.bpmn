      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_1euliym" name="update status as completed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-period-status" />
        <zeebe:ioMapping>
          <zeebe:input source="COMPLETED" target="status" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lxmrln</bpmn:incoming>
      <bpmn:outgoing>Flow_0zst0zu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1od5ahc" name="Start new period flow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="start-new-period-flow" />
        <zeebe:ioMapping>
          <zeebe:input source="=year + 1" target="nextYear" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yw2rpj</bpmn:incoming>
      <bpmn:outgoing>Flow_16z874u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_05zb67j">
      <bpmn:incoming>Flow_0zst0zu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1yw2rpj" sourceRef="Event_1wfkt10" targetRef="Activity_1od5ahc" />
    <bpmn:intermediateCatchEvent id="Event_1u337tr">
