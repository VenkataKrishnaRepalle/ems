        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">=startDate</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1b4bn7g" sourceRef="StartEvent_1" targetRef="Event_0o5lc9x" />
    <bpmn:sequenceFlow id="Flow_0ltwg8l" sourceRef="Event_0o5lc9x" targetRef="Activity_04c7jdp" />
    <bpmn:serviceTask id="Activity_04c7jdp" name="Send Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-review-notification" retries="=3" />
        <zeebe:ioMapping>
          <zeebe:input source="=reviewType" target="reviewType" />
          <zeebe:input source="=reviewStatus" target="reviewStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ltwg8l</bpmn:incoming>
      <bpmn:outgoing>Flow_1o609y0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_05s0cvl" name="Quarter waiting">
