    <bpmn:sequenceFlow id="Flow_088gk9n" sourceRef="Gateway_010weuy" targetRef="Activity_1x7ci59">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(has_pending_quarter)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0k3mnlo">
